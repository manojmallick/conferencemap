# Copy to .env.local and fill in. Get a key at https://aistudio.google.com/apikey
# The key must start with "AIza" (a Gemini API key), NOT "AQ." (an OAuth/ephemeral token).
GEMINI_API_KEY=
NEXT_PUBLIC_APP_NAME=ConferenceMap
NEXT_PUBLIC_APP_VERSION=1.0.0-hackathon

# Follow-up question suggestions: "true" (default) = Gemini-generated, natural
# phrasing (one small extra call ~1s); "false" = instant deterministic templates.
LLM_FOLLOWUPS=true
